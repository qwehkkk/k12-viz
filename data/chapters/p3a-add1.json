  "prereqChapters": [],
  "tagline": "口算不是「心里列竖式」，而是把数拆成整十整百，先算大的再补小的。",
  "textbook": "人教版三年级上册第二单元",
  "intro": "这一单元只练两件事：两位数加减两位数的口算，和几百几十加减几百几十。核心方法叫「拆分」——把 35 看成 30 和 5，把 380 看成 38 个十。拆分想通了，100 以内和 1000 以内是同一套动作，只是单位从「个」换成了「十」。",
  "examShare": "以口算、估算填空为主，分值不高但速度快慢直接影响后面笔算。估算「够不够」的应用题常考。",
  "emoji": "➕"
 },
 "points": [
  {
   "id": "p3a-add1-oral",
   "title": "两位数加减两位数的口算",
   "summary": "拆成「整十 + 个位」两步走：35 + 28 = 35 + 20 + 8。",
   "keyPoints": [
    "加法拆分：**先加整十、再加个位**（35 + 28 → 55 → 63）",
    "减法拆分：**先减整十、再减个位**（63 − 27 → 43 → 36）",
    "也可以两位都拆：30 + 20 = 50，5 + 8 = 13，50 + 13 = 63",
    "个位相加超过 10 时要**进位**，别漏掉那 1 个十"
   ],
   "prerequisites": [],
   "viz": {
    "type": "pm-oral",
    "title": "拖滑块，看拆分口算分几步走",
    "values": {
     "op": 0,
     "a": 35,
     "b": 28
    }
   },
   "apply": "买菜算账、看价钱心算——口算快的人用的都是拆分，不是竖式。",
   "blocks": [
    {
     "t": "p",
     "text": "口算的关键不是快，而是「有步骤」。把其中一个数拆开，就有了一条可以照着走的路。"
    },
    {
     "t": "viz",
     "viz": {
      "type": "pm-oral",
      "title": "35 + 28：先加 20，再加 8",
      "values": {
       "op": 0,
       "a": 35,
       "b": 28
      }
     }
    },
    {
     "t": "p",
     "text": "63 − 27 同理，只是方向相反：**先减 20 得 43，再减 7 得 36**。"
    }
   ]
  },
  {
   "id": "p3a-add1-tens",
   "title": "几百几十加减几百几十",
   "summary": "把 380 看成 38 个十，就变回两位数加减法。",
   "keyPoints": [
    "**380 = 38 个十**，260 = 26 个十，相加就是 38 + 26 = 64 个十 = 640",
    "减法同理：540 − 370 → 54 − 37 = 17 个十 = 170",
    "结果末尾一定要**补回 0**，写成 64 就错了",
    "本质：换单位，不换方法"
   ],
   "prerequisites": [
    "p3a-add1-oral"
   ],
   "viz": {
    "type": "pm-oral",
    "title": "切换「几个十」视角看同样的算式",
    "values": {
     "op": 1,
     "a": 380,
     "b": 260
    }
   },
   "apply": "算工资、算距离（380 米 + 260 米）、算钱（380 元 + 260 元）都是这类。",
   "blocks": [
    {
     "t": "p",
     "text": "孩子算 380 + 260 会卡，是因为把「380」当成一个整体。只要换成「38 个十」，立刻变成 38 + 26。"
    },
    {
     "t": "viz",
     "viz": {
      "type": "pm-oral",
      "title": "380 + 260 = 38 个十 + 26 个十",
      "values": {
       "op": 1,
       "a": 380,
       "b": 260
      }
     }
    },
    {
     "t": "p",
     "text": "最后别忘了单位：**64 个十就是 640**。"
    }
   ]
  },
  {
   "id": "p3a-add1-est",
   "title": "用估算判断「够不够」",
   "summary": "把数看成整百整十，先估一个大概，再决定够不够。",
   "keyPoints": [
    "估大：把 198 看成 200（**多估一点**，判断「够」更保险）",
    "估小：把 305 看成 300（**少估一点**，判断「不够」更保险）",
    "「够不够」题要**按需要选估大还是估小**，再比一次",
    "估算结果写「约等于」，用 **≈**，不是 ="
   ],
   "prerequisites": [
    "p3a-add1-oral"
   ],
   "viz": {
    "type": "pm-oral",
    "title": "拖动数值，看估大与估小的差别",
    "values": {
     "op": 2,
     "a": 198,
     "b": 305
    }
   },
   "apply": "超市买东西先估总价、出门看油够不够、装修算材料，都是估算先行。",
   "blocks": [
    {
     "t": "p",
     "text": "估算不是「随便估」，而是带着目的估：要证明够，就把每个数往大了估；要证明不够，就往小了估。"
    },
    {
     "t": "viz",
     "viz": {
      "type": "pm-oral",
      "title": "198 + 305 估成 200 + 300",
      "values": {
       "op": 2,
       "a": 198,
       "b": 305
      }
     }
    },
    {
     "t": "p",
     "text": "估出来 **500**，实际 **503**——估算能告诉你量级，不能告诉你精确值。"
    }
   ]
  },
  {
   "id": "p3a-add1-check",
   "title": "用估算检查计算结果",
   "summary": "算出答案先估一遍量级，差太远就是算错了。",
   "keyPoints": [
    "先估：493 + 208 ≈ 500 + 200 = 700",
    "再比：算出 601，和 700 差一百，**一定是错的**",
    "估算只能抓「大错」，抓不到「差 1」的小错",
    "检查顺序：先估量级，再查进位"
   ],
   "prerequisites": [
    "p3a-add1-est"
   ],
   "viz": {
    "type": "pm-oral",
    "title": "看估出来的范围和精确值差多远",
    "values": {
     "op": 3,
     "a": 493,
     "b": 208
    }
   },
   "apply": "考试检查、收银对账、工程复核——估算是第一道防线。",
   "blocks": [
    {
     "t": "p",
     "text": "与其从头再算一遍，不如先估一次：数字量级不对，后面全白算。"
    },
    {
     "t": "viz",
     "viz": {
      "type": "pm-oral",
      "title": "493 + 208 的估算与精确值",
      "values": {
       "op": 3,
       "a": 493,
       "b": 208
      }
     }
    },
    {
     "t": "p",
     "text": "误差控制在几十以内算正常；差出一百以上，回去查进位。"
    }
   ]
  }
 ],
