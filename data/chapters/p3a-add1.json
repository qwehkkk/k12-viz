   "steps": [
    {
     "text": "先估量级。",
     "math": "493 + 208 ≈ 500 + 200 = 700"
    },
    {
     "text": "601 与 700 差约 100，量级不对。",
     "math": ""
    },
    {
     "text": "重算：9 + 8 = 17 写 7 进 1，9 + 0 + 1 = 10 写 0 进 1，4 + 2 + 1 = 7。",
     "math": "493 + 208 = 701"
    }
   ],
   "answer": "不对，正确结果是 701"
  }
