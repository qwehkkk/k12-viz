       "b": 3
      }
     }
    },
    {
     "t": "p",
     "text": "面积模型看得最清楚：一个 23 × 3 的长方形，切成 20 × 3 和 3 × 3 两块。"
    }
   ]
  },
  {
   "id": "p3a-mult-vertical",
   "title": "乘法竖式与进位",
   "summary": "从个位乘起，满几十就向前一位进几。",
   "keyPoints": [
    "竖式写法：一位数写在下面，**个位对齐**",
    "从**个位**开始乘，不是从高位",
    "哪一位乘得的积满几十，就**向前一位进几**（进的是「十」的个数）",
    "下一位乘完要**加上进上来的数**，最后一位直接把进位写在前面"
   ],
   "prerequisites": [
    "p3a-mult-split"
   ],
   "viz": {
    "type": "pm-mult",
    "title": "128 × 4：看每一步进位",
    "values": {
     "a": 128,
     "b": 4
    }
   },
   "apply": "算总价、算产量、算路程，凡「每份多少 × 几份」都用它。",
   "blocks": [
    {
     "t": "p",
     "text": "进位的「几」和加法不一样：加法最多进 1，乘法可能进 2、3、4……因为一位数乘一位数最多得 81。"
    },
    {
     "t": "viz",
     "viz": {
      "type": "pm-mult",
      "title": "128 × 4 = 512",
      "values": {
       "a": 128,
       "b": 4
      }
     }
    },
    {
     "t": "p",
     "text": "个位 8 × 4 = 32，写 2 进 3；十位 2 × 4 + 3 = 11，写 1 进 1；百位 1 × 4 + 1 = 5。"
    }
   ]
  },
  {
   "id": "p3a-mult-zero",
   "title": "中间有 0、末尾有 0 的乘法",
   "summary": "中间的 0 也要乘、要加进位；末尾的 0 可以先撇开，最后补上。",
   "keyPoints": [
    "**中间有 0**：0 乘任何数得 0，但**要加上进位的数**（205 × 4 → 0 × 4 + 0 = 0，别忘了）",
    "**末尾有 0**：先把 0 前面的数相乘，再在积的末尾补上同样多的 0（340 × 2 → 34 × 2 = 68 → 680）",
    "末尾有 0 时竖式可以简写，把 0 提到右边一列外",
    "两类 0 的题最容易「少一位」，算完数一数位数"
   ],
   "prerequisites": [
    "p3a-mult-vertical"
   ],
   "viz": {
    "type": "pm-mult",
    "title": "205 × 4 与 340 × 2 的两种 0",
    "values": {
     "a": 205,
     "b": 4
    }
   },
   "apply": "买 4 箱 205 元的货、2 箱 340 元的货，都是这两种结构。",
   "blocks": [
    {
     "t": "p",
     "text": "中间的 0 和末尾的 0，处理方式完全不同：一个必须参与计算，一个可以先放一边。"
    },
    {
     "t": "viz",
     "viz": {
      "type": "pm-mult",
      "title": "205 × 4 = 820，340 × 2 = 680",
      "values": {
       "a": 205,
       "b": 4
      }
     }
    },
    {
     "t": "p",
     "text": "205 × 4：个位 5 × 4 = 20 写 0 进 2；十位 0 × 4 + 2 = 2；百位 2 × 4 = 8 → **820**。"
    }
   ]
  }
 ],
