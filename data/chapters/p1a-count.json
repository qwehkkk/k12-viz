    {
     "t": "viz",
     "viz": {
      "type": "p1a-count",
      "title": "模式 1：连线看剩余",
      "values": {
       "mode": 1
      }
     }
    },
    {
     "t": "p",
     "text": "数一数也能比，但一一对应更直观：**谁有剩下的谁就多**。"
    },
    {
     "t": "list",
     "items": [
      "一个对一个",
      "对上的同样多",
      "剩的多、缺的少",
      "先看清谁和谁比"
     ]
    }
   ]
  },
  {
   "id": "p1a-count-len",
   "title": "比长短、比高矮",
   "summary": "比长短要**一头对齐**放在同一起点；比高矮要站在同一水平面上。",
   "keyPoints": [
    "比长短：**一端对齐**，看另一端",
    "比高矮：站在**同一条线**上比",
    "不能斜着比、不能错位比",
    "有多个对象可以**两两比**排出顺序"
   ],
   "prerequisites": [
    "p1a-count-same"
   ],
