 "examples": [
  {
   "id": "p6b-cyl-e1",
   "point": "p6b-cyl-surface",
   "title": "求侧面积",
   "question": "一个圆柱底面半径 3 cm，高 10 cm。它的侧面积是多少？（π 取 3.14）",
   "steps": [
    {
     "text": "侧面积 = 底面周长 × 高。",
     "math": "2 × 3.14 × 3 × 10"
    },
    {
     "text": "先算底面周长。",
     "math": "2 × 3.14 × 3 = 18.84（cm）"
    },
    {
     "text": "再乘高。",
     "math": "18.84 × 10 = 188.4（cm²）"
    }
   ],
   "answer": "188.4 cm²"
  },
  {
   "id": "p6b-cyl-e2",
   "point": "p6b-cyl-surface",
   "title": "求表面积（无盖）",
   "question": "一个无盖圆柱形水桶，底面直径 4 dm，高 5 dm。做这个水桶至少需要多少铁皮？（π 取 3.14）",
   "steps": [
    {
     "text": "半径 = 4 ÷ 2 = 2 dm。",
     "math": ""
    },
    {
     "text": "侧面积。",
     "math": "2 × 3.14 × 2 × 5 = 62.8（dm²）"
    },
    {
     "text": "无盖只加一个底面积。",
     "math": "3.14 × 2² = 12.56（dm²）"
    },
    {
     "text": "合计。",
     "math": "62.8 + 12.56 = 75.36（dm²）"
    }
   ],
   "answer": "75.36 dm²"
  },
  {
   "id": "p6b-cyl-e3",
   "point": "p6b-cyl-volume",
   "title": "求体积",
   "question": "圆柱底面半径 2 cm，高 6 cm。体积是多少？（π 取 3.14）",
   "steps": [
    {
     "text": "先求底面积。",
     "math": "3.14 × 2² = 12.56（cm²）"
    },
    {
     "text": "再乘高。",
     "math": "12.56 × 6 = 75.36（cm³）"
    }
   ],
   "answer": "75.36 cm³"
  },
  {
   "id": "p6b-cyl-e4",
   "point": "p6b-cyl-volume",
   "title": "容积换算",
   "question": "一个圆柱形水桶底面直径 4 dm、高 5 dm，最多能装水多少升？（π 取 3.14）",
   "steps": [
    {
     "text": "半径 2 dm，底面积。",
     "math": "3.14 × 2² = 12.56（dm²）"
    },
    {
     "text": "体积。",
     "math": "12.56 × 5 = 62.8（dm³）"
    },
    {
     "text": "1 dm³ = 1 L。",
     "math": "62.8 dm³ = 62.8 L"
    }
   ],
   "answer": "62.8 升"
  },
  {
   "id": "p6b-cyl-e5",
   "point": "p6b-cone-volume",
   "title": "求圆锥体积",
   "question": "一个圆锥底面半径 3 cm、高 4 cm。体积是多少？（π 取 3.14）",
   "steps": [
    {
     "text": "底面积。",
     "math": "3.14 × 3² = 28.26（cm²）"
    },
    {
     "text": "圆锥体积要乘 1/3。",
     "math": "1/3 × 28.26 × 4"
    },
    {
     "text": "计算。",
     "math": "= 37.68（cm³）"
    }
   ],
   "answer": "37.68 cm³"
  },
  {
   "id": "p6b-cyl-e6",
   "point": "p6b-cone-volume",
   "title": "削成最大的圆锥",
   "question": "把一个底面半径 2 cm、高 9 cm 的圆柱削成一个最大的圆锥，削去部分的体积是多少？（π 取 3.14）",
   "steps": [
    {
     "text": "圆柱体积。",
     "math": "3.14 × 2² × 9 = 113.04（cm³）"
    },
    {
     "text": "最大圆锥是圆柱的 1/3，削去的是 2/3。",
     "math": "113.04 × 2/3 = 75.36（cm³）"
    }
   ],
   "answer": "75.36 cm³"
  }
