   "apply": "0.5 千克 = 半千克；0.1 米 = 1 分米。",
   "blocks": [
    {
     "t": "p",
     "text": "小数不是新东西，它是分数的另一种写法：**分母是 10 的分数，可以直接写成一位小数**。"
    },
    {
     "t": "viz",
     "viz": {
      "type": "ep-dec",
      "title": "0.7：把 0 到 1 分成 10 份，取 7 份",
      "values": {
       "d": 0.7
      }
     }
    },
    {
     "t": "list",
     "items": [
      "1/10 = 0.1",
      "3/10 = 0.3",
      "7/10 = 0.7",
      "10/10 = 1"
     ]
    },
    {
     "t": "p",
     "text": "读法按小数点念：0.7 读作「零点七」，1.2 读作「一点二」——**小数点读「点」，后面一位一位念**。"
    }
   ]
  },
