     "leap": 0
    }
   },
   "apply": "火车票写 19:30 发车，就是晚上 7 点半；营业时间 9:00—21:00 是早 9 点到晚 9 点。",
   "blocks": [
    {
     "t": "p",
     "text": "24 时计时法把一天从 0 数到 24，不用再说「上午/下午」，所以车票、时刻表都用它。"
    },
    {
     "t": "list",
     "items": [
      "上午 9 时 = 9:00",
      "下午 3 时 = 15:00（3 + 12）",
      "晚上 8 时 = 20:00（8 + 12）",
      "午夜 12 时 = 24:00 或次日 0:00"
     ]
    },
    {
     "t": "viz",
     "viz": {
      "type": "ep-cal",
      "title": "下午的时刻加 12 就换成 24 时计时法",
      "values": {
       "month": 6,
       "leap": 0
      }
     }
    },
    {
     "t": "p",
     "text": "算经过时间就用减法：8:20 到 11:05，先算到 11:00 是 2 小时 40 分，再加 5 分，共 2 小时 45 分。"
    }
   ]
  }
