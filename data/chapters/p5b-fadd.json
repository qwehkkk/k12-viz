       "b": 1,
       "d": 3
      }
     }
    },
    {
     "t": "p",
     "text": "通分三步：① 求分母最小公倍数；② 两个分数同乘放大；③ 按同分母加减，最后化简。"
    },
    {
     "t": "list",
     "items": [
      "1/2 + 1/3 → 3/6 + 2/6 = 5/6",
      "3/4 − 1/6 → 9/12 − 2/12 = 7/12",
      "1 − 2/5 = 3/5（1 化成 5/5）"
     ]
    }
   ]
  },
